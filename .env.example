# Copie para .env.local e preencha com os dados do seu projeto no Supabase:
# Project Settings → API Keys (ou Data API) no painel do Supabase.
# Estas duas chaves são públicas por natureza (o RLS protege os dados).
# NUNCA coloque aqui a chave secreta (service_role / sb_secret_...).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Projetos antigos usam a chave "anon" (JWT). Também funciona:
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
