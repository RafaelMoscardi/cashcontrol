{
  "name": "cashcontrol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Planejamento e controle financeiro para motoristas de aplicativo e entregadores.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/dev-local.ts",
    "local-supabase": "node scripts/local-supabase/server.ts",
    "seed:local": "node scripts/local-supabase/seed.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/icons/generate.ts",
    "catalogo:fipe": "node scripts/fipe/gerar-catalogo.ts",
    "consumo:inmetro": "node scripts/inmetro/gerar-consumo.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
