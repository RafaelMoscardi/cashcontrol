    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "react-router": "^8.5.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
